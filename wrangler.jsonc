// Cloudflare Workers config for bgremovers.org.
//
// Worker entrypoint:
//   • 301 redirect www → apex
//   • REST API at /api/v1/* (background removal with 100/day per-IP rate limit)
//   • Static asset binding for everything else
//
// Bindings needed for the REST API (added below):
//   • RATE_LIMIT  (KV namespace) — IP→counter for daily rate limiting.
//                 Create once via: `npx wrangler kv:namespace create RATE_LIMIT`
//                 then paste the returned id into the placeholder below.
//   • HF_TOKEN    (secret) — Hugging Face Inference API token. Without it
//                 the REST API responds 503 and recommends the JS SDK.
//                 Add via: `npx wrangler secret put HF_TOKEN`
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bgremove",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-15",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ]
}
