// Cloudflare Workers config for bgremovers.org.
//
// Worker entrypoint:
//   • 301 redirect www → apex
//   • REST API at /api/v1/* (background removal with 100/day per-IP rate limit)
//   • Static asset binding for everything else
//
// Bindings needed for the REST API (added below):
//   • RATE_LIMIT  (KV namespace, optional) — IP→counter for daily rate
//                 limiting. Not bound yet: a placeholder id here made every
//                 deploy fail. To enable, create it
//                 (`npx wrangler kv namespace create RATE_LIMIT`) and add
//                 { "binding": "RATE_LIMIT", "id": "<id>" } below.
//   • HF_TOKEN    (secret) — Hugging Face Inference API token. Without it
//                 the REST API responds 503 and recommends the JS SDK.
//                 Add via: `npx wrangler secret put HF_TOKEN`
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bgremove",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-15",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "kv_namespaces": [
    {
      // Feedback popup answers (POST /api/feedback).
      // Namespace "bgremove-FEEDBACK" (created in the dashboard).
      // Read answers at /admin/feedback/ — needs the FEEDBACK_ADMIN_KEY secret
      // (Worker → Settings → Variables and Secrets).
      "binding": "FEEDBACK",
      "id": "b2b675880a1043ada88c5a30fa0ebafd"
    }
  ],
  // Nightly copy of Cloudflare Web Analytics into D1 (worker/index.ts → scheduled).
  // Needs two Worker secrets set in the dashboard: CF_ANALYTICS_TOKEN
  // (Account Analytics: Read) and CF_ACCOUNT_ID.
  "triggers": { "crons": ["30 1 * * *"] },
  "d1_databases": [
    {
      // Anonymous usage counters (POST /api/event, GET /api/usage).
      "binding": "USAGE",
      "database_name": "bgremove-usage",
      "database_id": "18c0a918-be82-4a75-b3d5-22c2b6ad73a3"
    }
  ]
}
